# Copia este archivo como .env y completa los secretos antes de desplegar.
POSTGRES_DB=botica_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Conserva prod en EC2. Usa dev únicamente en una máquina local de pruebas.
SPRING_PROFILES_ACTIVE=prod

# Clave aleatoria de al menos 32 bytes codificada en Base64.
JWT_SECRET=
JWT_EXPIRATION_MS=900000

# Debe ser true detrás de HTTPS. Usa false solo durante desarrollo local por HTTP.
COOKIE_SECURE=true

BACKEND_PORT=9091
FRONTEND_PORT=80

# Solo se usa cuando un navegador accede directamente al backend. Si tienes
# dominio, agrega por ejemplo: https://botica.ejemplo.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8080,http://127.0.0.1:8080
IGV_TASA=0.18

# Consulta opcional de DNI y RUC con JSON.pe.
DOCUMENT_LOOKUP_ENABLED=false
DOCUMENT_LOOKUP_PROVIDER=JSON_PE
DOCUMENT_LOOKUP_BASE_URL=https://api.json.pe
JSONPE_TOKEN=
DOCUMENT_LOOKUP_TIMEOUT_MS=3000

# Habilita estas variables solo en el primer arranque de una base vacía.
# Después de iniciar sesión, vuelve a false y elimina BOOTSTRAP_ADMIN_PASSWORD.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Administrador inicial

# Solo para un entorno local con SPRING_PROFILES_ACTIVE=dev. No lo habilites en EC2.
DEMO_DATA_ENABLED=false
DEMO_ADMIN_PASSWORD=
DEMO_CASHIER_PASSWORD=
DEMO_STOCKKEEPER_PASSWORD=

# Facturación electrónica SUNAT. Inicia en BETA y habilita solo después de
# registrar un emisor, usuario SOL y certificado digital PKCS12 válidos.
SUNAT_ENABLED=false
SUNAT_MODE=BETA
SUNAT_RUC=
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_CERTIFICATE_BASE64=
SUNAT_CERTIFICATE_PASSWORD=
SUNAT_RAZON_SOCIAL=
SUNAT_NOMBRE_COMERCIAL=
SUNAT_UBIGEO=
SUNAT_DIRECCION=
SUNAT_DEPARTAMENTO=LIMA
SUNAT_PROVINCIA=LIMA
SUNAT_DISTRITO=LIMA
SUNAT_PROCESAMIENTO_MS=60000
SUNAT_RESUMEN_PROCESAMIENTO_MS=60000
