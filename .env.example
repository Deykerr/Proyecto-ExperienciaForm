# Copia este archivo como .env y completa los secretos antes de desplegar.
POSTGRES_DB=botica_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Clave aleatoria de al menos 32 bytes codificada en Base64.
JWT_SECRET=

BACKEND_PORT=9091
FRONTEND_PORT=80

# Solo se usa cuando un navegador accede directamente al backend. Si tienes
# dominio, agrega por ejemplo: https://botica.ejemplo.com
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost
